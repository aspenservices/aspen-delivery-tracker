// ═══════════════════════════════════════════════════════════════════════════
// ASPEN DELIVERY TRACKER — REGLAS DE LA REALTIME DATABASE       Fase D · 31 jul 2026
// ═══════════════════════════════════════════════════════════════════════════
// ANTES: .read/.write = "auth != null" en la raiz.
// Eso no distinguia al equipo de un cliente: los dos usaban la MISMA sesion
// anonima, y la clave de Firebase iba dentro de prep.html — o sea, en el
// navegador de cada cliente al que se le mando un link. Cualquiera que se
// molestara en abrir una sesion anonima podia leer y escribir toda la base.
//
// AHORA: el login pasa por la Cloud Function deliveryLogin, que devuelve un
// custom token con el claim staff:true. Eso es lo que se exige aqui.
// El portal del cliente ya no toca la base: prep.html habla con portalGet y
// portalSubmit, que escriben con Admin SDK y no pasan por estas reglas.
//
// POR QUE "users" SIGUE ABIERTO A SESION ANONIMA:
// el desplegable de nombres de la pantalla de login se pinta ANTES de tener
// token. Sin lectura ahi, no hay forma de iniciar sesion. Escribir sigue
// siendo solo del personal.
//
// PENDIENTE (Fase E): vaciar "pinHash" de users. Hasta entonces esos hashes
// siguen al alcance de una sesion anonima — son PIN de 4 digitos con sal fija.
// El respaldo del login viejo los necesita, por eso no se pueden quitar aun.
//
// PARA REVERTIR: dejar solo .read/.write = "auth != null" en la raiz.
// Un clic en la consola, efecto inmediato.
// ═══════════════════════════════════════════════════════════════════════════
{
  "rules": {
    ".read": false,
    ".write": false,

    // La lista de nombres del login. Sin pinHash a partir de la Fase E.
    "users": {
      ".read": "auth != null",
      ".write": "auth.token.staff === true"
    },

    // Todo lo demas: intake, base, edits, added, presence, gcal_map,
    // invoice_pdfs, deleted_tickets, staff_auth, auth_attempts, etc.
    // En RTDB el hijo con nombre manda sobre el comodin, asi que "users"
    // conserva su regla propia y este $rest cubre el resto.
    "$rest": {
      ".read":  "auth.token.staff === true",
      ".write": "auth.token.staff === true"
    }
  }
}
